; Flat node_modules layout. The Docker runtime stage copies only the root
; `node_modules` (plus the package's `dist`), so every runtime dependency —
; the queue adapters (`@nats-io/transport-node`, `mqtt`) and the optional
; `firebase-admin` destination peer — must resolve from the root tree. pnpm's
; default isolated linker symlinks a workspace package's deps under
; `packages/ts/whistlers/node_modules`, which the image never copies, so the
; bundled server crashes with ERR_MODULE_NOT_FOUND at first lazy import.
node-linker=hoisted
